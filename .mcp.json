{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context", "claude-code",
        "--open-web-dashboard", "False",
        "--project", "${CLAUDE_PROJECT_DIR:-.}"
      ],
      "env": {}
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run", "--with", "graphifyy", "--with", "mcp",
        "-m", "graphify.serve", "graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}
